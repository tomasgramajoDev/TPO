# Copiar como .env antes de iniciar. No versionar valores reales.
# Contraseña de la base PostgreSQL local (obligatoria).
DB_PASSWORD=
# Secreto JWT local de al menos 32 caracteres (obligatorio).
JWT_SECRET=
# Contraseña compartida de las seis cuentas demo (obligatoria, no se imprime en logs).
DEMO_PASSWORD=
# Credencial del RabbitMQ local incluido en el stack (obligatoria).
RABBITMQ_PASSWORD=

